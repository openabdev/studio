{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OAB Studio",
  "version": "0.1.0",
  "identifier": "dev.openab.studio",
  "build": {
    "frontendDist": "../console/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix console run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OAB Studio",
        "width": 1000,
        "height": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/oab-mcp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
